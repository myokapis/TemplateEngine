<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <IsPackable>true</IsPackable>
    </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>10.0.0</Version>
    <PackageId>MyOkapis.TemplateEngine.AspNetCore</PackageId>
    <AssemblyName>MyOkapis.TemplateEngine.AspNetCore</AssemblyName>
    <RootNamespace>MyOkapis.TemplateEngine.AspNetCore</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <OutputType>Library</OutputType>
    <Copyright>Copyright © Gene Graves 2018-2023</Copyright>
    <Description>Dependency injection extensions for including MyOkapis.TemplateEngine in Asp.Net Core applications</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageProjectUrl>https://github.com/myokapis/TemplateEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/myokapis/TemplateEngine</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Authors>Gene Graves</Authors>
    <PackageTags>MyOkapis.TemplateEngine</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.0.0.0</FileVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyOkapis.TemplateEngine\MyOkapis.TemplateEngine.csproj" />
  </ItemGroup>

</Project>
