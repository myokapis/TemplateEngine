<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <IsPackable>true</IsPackable>
    </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0-rc1</Version>
    <Title>MyOkapis Template Engine - ASP.NET Core</Title>
    <PackageId>MyOkapis.TemplateEngine.AspNetCore</PackageId>
    <AssemblyName>MyOkapis.TemplateEngine.AspNetCore</AssemblyName>
    <RootNamespace>MyOkapis.TemplateEngine.AspNetCore</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <OutputType>Library</OutputType>
    <Copyright>Copyright © Gene Graves 2018-2026</Copyright>
    <Description>Dependency injection extensions for including MyOkapis.TemplateEngine in Asp.Net Core applications</Description>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackageProjectUrl>https://github.com/myokapis/TemplateEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/myokapis/TemplateEngine</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Authors>Gene Graves</Authors>
    <PackageTags>template aspnetcore dependency-injection web</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MyOkapis.TemplateEngine" Version="1.0.0-rc1" />
    <PackageReference Include="MyOkapis.TemplateEngine.Web" Version="1.0.0-rc1" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MyOkapis.TemplateEngine.AspNetCore.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
